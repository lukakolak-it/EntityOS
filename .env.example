TARGET_RADAR_ENV=local
LOG_LEVEL=INFO

# Keep real local databases out of Git.
DATABASE_URL=sqlite:///data/target-radar.local.sqlite3

# Local UI
TARGET_RADAR_HOST=127.0.0.1
TARGET_RADAR_PORT=8765
LOG_FILE=logs/target-radar.jsonl

# GitHub integration. Fill real values in .env, not here.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# LLM routing
LLM_PROVIDER=local
LLM_MODEL=llama3.1:8b

# Rating uses the Light profile by default. Heavy can stay configured for later,
# but the local pipeline does not initialize it in the default rating path.
LLM_HEAVY_PROVIDER=openai
LLM_HEAVY_MODEL=gpt-5.5
LLM_LIGHT_PROVIDER=ollama
LLM_LIGHT_MODEL=qwen3:30b-a3b-q4_K_M

# Cloud LLM providers. OpenAI is implemented. Anthropic, Gemini and Mistral
# fields are reserved for future provider clients and are not selectable yet.
# Fill real values in .env, not here.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=

# Local AI, e.g. Ollama or an OpenAI-compatible local server.
# For Ollama, start `ollama serve` and pull the configured Light model.
LOCAL_AI_PROVIDER=ollama
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=llama3.1:8b
LOCAL_AI_API_KEY=

# Search engine / discovery providers.
# mock works without secrets. brave requires BRAVE_API_KEY or SEARCH_ENGINE_TOKEN.
SEARCH_PROVIDER=mock
SEARCH_ENGINE_TOKEN=
BRAVE_API_KEY=
SERPAPI_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
SEARXNG_BASE_URL=

# Product defaults
TARGET_RADAR_REQUEST_BUDGET=100
TARGET_RADAR_RESULTS_PER_QUERY=10
TARGET_RADAR_MAX_RAW_RESULTS=1000
TARGET_RADAR_DEFAULT_PROVIDER=mock
TARGET_RADAR_SOURCE_BLOCK_THRESHOLD=35
TARGET_RADAR_BLOCKED_SOURCE_DOMAINS=
TARGET_RADAR_MIN_RULE_SCORE_FOR_AI=40
TARGET_RADAR_MIN_AI_SCORE_FOR_REVIEW=50
TARGET_RADAR_MIN_AI_SCORE_FOR_DRAFT=70
TARGET_RADAR_MIN_CONFIDENCE_FOR_DRAFT=0.55
TARGET_RADAR_HARD_STOP_ACTION=skip
TARGET_RADAR_FETCH_TIMEOUT_SECONDS=10
TARGET_RADAR_MAX_PAGES_PER_TARGET=4
TARGET_RADAR_USER_AGENT=TargetRadar/0.1 local
TARGET_RADAR_REVIEW_PAGE_SIZE=50
TARGET_RADAR_REVIEW_MAX_PAGE_SIZE=100
TARGET_RADAR_DRAFT_LANGUAGE=de
TARGET_RADAR_DRAFT_TYPE=application_email
TARGET_RADAR_DRAFT_MAX_BODY_CHARS=4000
